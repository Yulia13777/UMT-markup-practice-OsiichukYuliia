# Base path of the Flora backend API. In dev, Vite proxies "/api" to the
# backend (see vite.config.js), so a relative path works without CORS.
VITE_API_BASE_URL="/api"
# For GitHub Pages / static hosting (lesson 29-30): emit dist/api/*.json and
# fetch the catalogue from files. Set in CI. For local dev, leave it off.
# VITE_API_MODE=static
